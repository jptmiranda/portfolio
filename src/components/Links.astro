---
import { Icon } from "astro-icon/components";
import Anchor from "./Anchor.astro";
---

<div class="flex flex-col items-start gap-y-3">
  <Anchor href="https://github.com/jptmiranda" new-tab>
    <span>Github</span>
    <Icon class="size-5" name="carbon:launch" />
  </Anchor>

  <Anchor href="https://www.linkedin.com/in/jptmiranda" new-tab>
    <span>LinkedIn</span>
    <Icon class="size-5" name="carbon:launch" />
  </Anchor>

  <div class="flex items-center gap-x-2">
    <Anchor href="mailto:joao.t.m@proton.me" new-tab>
      <span>Email</span>
      <Icon class="size-5" name="carbon:launch" />
    </Anchor>

    <button
      type="button"
      onclick="navigator.clipboard.writeText('joao.t.m@proton.me')"
      aria-label="Copy email"
      class="w-fit hover:bg-background-darker hover:text-primary hover:p-1 hover:-m-1 hover:rounded hover:cursor-pointer"
    >
      <Icon class="size-5" name="carbon:copy" />
    </button>
  </div>
</div>
