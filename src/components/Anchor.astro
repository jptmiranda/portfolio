---
export interface Props {
  href: string;
  "new-tab"?: boolean;
}

const { href, "new-tab": newTab = false } = Astro.props;
---

<a
  rel="noopener noreferrer"
  href={href}
  target={newTab ? "_blank" : undefined}
  class="w-fit flex items-center gap-x-2 hover:bg-background-darker hover:text-primary hover:p-1 hover:-m-1 hover:rounded"
>
  <slot />
</a>
