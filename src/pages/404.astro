---
import Layout from "@/layouts/DefaultLayout.astro";
---

<Layout title="404: Not found">
  <div class="flex flex-col items-center">
    <h1 class="text-4xl">
      <span class="text-primary">404:</span>

      <span>Not Found</span>
    </h1>

    <p class="border border-foreground rounded px-2 py-4 mb-4">
      {Astro.url.pathname}
    </p>

    <a href="/" class="underline hover:text-primary">Homepage</a>
  </div>
</Layout>
